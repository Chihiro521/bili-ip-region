{
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "name": "B站 IP 属地",
  "version": "0.4.4",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "显示评论、楼中楼、动态正文、专栏发表属地与 UP 主主页属地。支持灰底白字胶囊，空字段不添加标签。",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://t.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://app.bilibili.com/*",
    "https://grpc.biliapi.net/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "https://passport.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://space.bilibili.com/*"
      ],
      "js": [
        "comment-bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://t.bilibili.com/*",
        "https://space.bilibili.com/*"
      ],
      "js": [
        "comment-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://space.bilibili.com/*"
      ],
      "js": [
        "profile-page.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["article-page.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/*", "https://t.bilibili.com/*", "https://space.bilibili.com/*"],
      "js": ["dynamic-main.js"], "world": "MAIN", "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/*", "https://t.bilibili.com/*", "https://space.bilibili.com/*"],
      "js": ["dynamic-page.js"], "world": "ISOLATED", "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "B 站 IP 属地设置",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
